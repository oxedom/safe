{
  "manifest_version": 3,
  "name": "Safe (YOLO image blur POC)",
  "short_name": "Safe",
  "version": "0.1.0",
  "description": "Blurs images that contain YOLOv7 (COCO) detections. Local-only POC.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/defaults.js", "content/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "host_permissions": ["<all_urls>"],
  "permissions": [
    "scripting",
    "tabs",
    "activeTab",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "webRequest",
    "webNavigation"
  ]
}
